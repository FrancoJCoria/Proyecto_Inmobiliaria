@{
	ViewData["Title"] = "Informes de Inmuebles";
}

<h1>Informes de Inmuebles</h1>

<p class="text-muted">Elija un informe para consultar.</p>

<div class="list-group w-50">
	<a asp-action="MasReservados" class="list-group-item list-group-item-action">
		<h5 class="mb-1">Inmuebles más reservados</h5>
		<p class="mb-1 text-muted">Lista los inmuebles con mayor cantidad de reservas en los últimos 365 días.</p>
	</a>
	<a asp-action="MenosReservados" class="list-group-item list-group-item-action">
		<h5 class="mb-1">Inmuebles menos reservados</h5>
		<p class="mb-1 text-muted">Lista los inmuebles con menor cantidad de reservas en el plazo indicado.</p>
	</a>
	<a asp-action="BuscarDisponibles" class="list-group-item list-group-item-action">
		<h5 class="mb-1">Inmuebles libres por fecha</h5>
		<p class="mb-1 text-muted">Lista los inmuebles no ocupados en una reserva entre dos fechas.</p>
	</a>
</div>

<p class="mt-3">
	<a asp-action="Index" class="btn btn-secondary">Volver a Inmuebles</a>
</p>