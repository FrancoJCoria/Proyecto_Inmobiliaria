@model IEnumerable<Inmobiliaria.Models.Inmueble>

@{
	ViewData["Title"] = "Inmuebles por propietario";
	int cantidad = (int)(ViewData["Cantidad"] ?? 0);
	// El desplegable no trae el catalogo: las opciones llegan por AJAX cuando el usuario
	// escribe. Lo unico que se trae por id es la etiqueta del propietario que venia
	// elegido en la url, para que el filtro muestre la seleccion vigente.
	var propietarioSeleccionado = ViewBag.PropietarioSeleccionado as Inmobiliaria.Models.OpcionDesplegable;
}

<h1>Inmuebles de @(propietarioSeleccionado != null ? propietarioSeleccionado.Etiqueta : "todos los propietarios") (@cantidad)</h1>

@* El desplegable se envía por GET: el propietario elegido es el filtro del informe. El
   buscador de opciones vive adentro del desplegable y pega contra el servidor, asi que no
   hace falta un campo de texto aparte en el formulario. *@
<form asp-action="PorPropietario" method="get" class="card card-body bg-light mb-3">
	<div class="row g-3 align-items-end">
		<div class="col-md-4">
			<label for="filtroPropietario" class="form-label fw-bold">Propietario:</label>
			<select name="idPropietario" id="filtroPropietario" class="form-select">
				<option value="">-- Todos los propietarios --</option>
				@if (propietarioSeleccionado != null)
				{
					<option value="@propietarioSeleccionado.Id" selected>@propietarioSeleccionado.Etiqueta</option>
				}
			</select>
			<div class="form-text">Escribí al menos 3 caracteres para buscar por apellido, nombre o DNI.</div>
		</div>
		<div class="col-md-4 d-flex gap-2">
			<button type="submit" class="btn btn-primary w-100">Filtrar</button>
			<a asp-action="PorPropietario" class="btn btn-outline-secondary w-100">Limpiar</a>
		</div>
	</div>
</form>

<partial name="_TablaInmuebles" model="Model" />

@if (!Model.Any())
{
	<div class="alert alert-info">No hay inmuebles para el propietario elegido.</div>
}

<!------------------ Controles de paginación ------------------>
@await Html.PartialAsync("_Paginador")

<p>
	<a asp-action="Informes" class="btn btn-secondary">Volver a Informes</a>
</p>

@section Scripts {
	<partial name="_ScriptDesplegable" />
	<script>
		activarDesplegable('#filtroPropietario',
			'@Url.Action("BuscarPropietarios", "Propietario")', '-- Todos los propietarios --', '');
	</script>
}
