@model IEnumerable<Inmobiliaria.Models.Inmueble>

@{
	ViewData["Title"] = "Inmuebles más reservados";
	int cantidad = (int)(ViewData["Cantidad"] ?? 0);
}

<h1>Inmuebles más reservados en los últimos 365 días (@cantidad)</h1>

@if (Model.Any())
{
	<table class="table table-striped align-middle">
		<thead>
			<tr>
				<th>Foto</th>
				<th>Direccion</th>
				<th>Tipo</th>
				<th>Cupo</th>
				<th>Precio por dia</th>
				<th>Propietario</th>
				<th>Reservas</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@if (!string.IsNullOrEmpty(item.Portada))
						{
							<img src="@item.Portada" alt="Foto" class="img-thumbnail" style="width: 70px; height: 50px; object-fit: cover;" />
						}
						else
						{
							<span class="text-muted" style="font-size: 0.8rem;">Sin foto</span>
						}
					</td>
					<td>@item.Direccion</td>
					<td>@item.NombreTipo</td>
					<td>@item.Cupo</td>
					<td>@item.Precio_dia.ToString("C")</td>
					<td>@item.NombrePropietario</td>
					<td>@item.CantidadReservas</td>
					<td>
						<a asp-action="Details" asp-route-id="@item.Id_inmueble" class="btn btn-sm btn-info">Detalles</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">No hay inmuebles con reservas en el último año.</div>
}

<!------------------ Controles de paginación ------------------>
@await Html.PartialAsync("_Paginador")

<p>
	<a asp-action="Informes" class="btn btn-secondary">Volver a Informes</a>
</p>
