@model Inmobiliaria.Models.Inmueble

@{
	ViewData["Title"] = "Editar Inmueble";
	// Ningun desplegable trae el catalogo: las opciones llegan por AJAX cuando el usuario
	// escribe. Lo unico que se trae por id es la etiqueta de lo que ya estaba elegido, para
	// que el desplegable muestre el valor vigente en vez de arrancar vacio. El controlador
	// la resuelve con consultas por clave primaria, no con listados.
	var propietarioSeleccionado = ViewBag.PropietarioSeleccionado as Inmobiliaria.Models.OpcionDesplegable;
	var tipoSeleccionado = ViewBag.TipoSeleccionado as Inmobiliaria.Models.OpcionDesplegable;
}

<h1>Editar Inmueble</h1>

<div class="row">
	<div class="col-md-6">
		<form asp-action="Edit" method="post">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" name="id" value="@Model.Id_inmueble" />
			<input type="hidden" asp-for="Id_inmueble" />
			<input type="hidden" asp-for="Estado" />
			<div class="mb-3">
				<label asp-for="Direccion" class="form-label">Direccion</label>
				<input asp-for="Direccion" class="form-control" />
				<span asp-validation-for="Direccion" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Id_tipo" class="form-label">Tipo de inmueble</label>
				<select asp-for="Id_tipo" class="form-select">
					<option value="0">-- Elegir tipo --</option>
					@if (tipoSeleccionado != null)
					{
						<option value="@tipoSeleccionado.Id">@tipoSeleccionado.Etiqueta</option>
					}
				</select>
				<div class="form-text">Escribí al menos 3 caracteres para buscar.</div>
				<span asp-validation-for="Id_tipo" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Id_propietario" class="form-label">Propietario</label>
				<select asp-for="Id_propietario" class="form-select">
					<option value="0">-- Elegir propietario --</option>
					@if (propietarioSeleccionado != null)
					{
						<option value="@propietarioSeleccionado.Id">@propietarioSeleccionado.Etiqueta</option>
					}
				</select>
				<div class="form-text">Se busca por apellido, nombre o DNI.</div>
				<span asp-validation-for="Id_propietario" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Cupo" class="form-label">Cupo de personas</label>
				<input asp-for="Cupo" type="number" class="form-control" />
				<span asp-validation-for="Cupo" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Precio_dia" class="form-label">Precio por dia</label>
				<input asp-for="Precio_dia" type="number" step="0.01" class="form-control" />
				<span asp-validation-for="Precio_dia" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Porcentaje_reserva" class="form-label">Porcentaje de reserva</label>
				<input asp-for="Porcentaje_reserva" type="number" step="0.01" class="form-control" />
				<span asp-validation-for="Porcentaje_reserva" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Portada" class="form-label">Foto de portada</label>
				<input asp-for="Portada" class="form-control" placeholder="url de la imagen" />
				<span asp-validation-for="Portada" class="text-danger"></span>
			</div>
			<div class="mb-3 form-check">
				<input asp-for="Disponible" class="form-check-input" />
				<label asp-for="Disponible" class="form-check-label">Disponible para alquilar</label>
			</div>
			<button type="submit" class="btn btn-primary">Guardar</button>
			<a asp-action="Index" class="btn btn-secondary">Volver</a>
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<partial name="_ScriptDesplegable" />
	<script>
		activarDesplegable('#Id_tipo', '@Url.Action("BuscarTipos", "TipoInmueble")', '-- Elegir tipo --', 0);
		activarDesplegable('#Id_propietario', '@Url.Action("BuscarPropietarios", "Propietario")', '-- Elegir propietario --', 0);
	</script>
}
