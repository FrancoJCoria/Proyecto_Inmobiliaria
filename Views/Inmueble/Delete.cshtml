@model Inmobiliaria.Models.Inmueble

@{
	ViewData["Title"] = "Eliminar Inmueble";
	var propietarios = ViewBag.Propietarios as IList<Inmobiliaria.Models.Propietario>;
	var tipos = ViewBag.Tipos as IList<Inmobiliaria.Models.TipoInmueble>;
	var duenio = propietarios?.FirstOrDefault(p => p.Id_propietario == Model.Id_propietario);
	var tipo = tipos?.FirstOrDefault(t => t.Id_tipo == Model.Id_tipo);
}

<h1>Eliminar Inmueble</h1>

<div class="alert alert-warning">¿Confirma que desea dar de baja este inmueble?</div>

<dl class="row">
	<dt class="col-sm-4">@Html.DisplayNameFor(model => model.Direccion)</dt>
	<dd class="col-sm-8">@Model.Direccion</dd>
	<dt class="col-sm-4">Tipo de inmueble</dt>
	<dd class="col-sm-8">@(tipo != null ? tipo.Nombre : Model.Id_tipo.ToString())</dd>
	<dt class="col-sm-4">Propietario</dt>
	<dd class="col-sm-8">@(duenio != null ? duenio.Apellido + ", " + duenio.Nombre : Model.Id_propietario.ToString())</dd>
	<dt class="col-sm-4">@Html.DisplayNameFor(model => model.Cupo)</dt>
	<dd class="col-sm-8">@Model.Cupo personas</dd>
	<dt class="col-sm-4">Precio por dia</dt>
	<dd class="col-sm-8">@Model.Precio_dia.ToString("C")</dd>
</dl>

<form asp-action="Delete" method="post">
	<input type="hidden" name="id" value="@Model.Id_inmueble" />
	<button type="submit" class="btn btn-danger">Dar de baja</button>
	<a asp-action="Index" class="btn btn-secondary">Volver</a>
</form>
