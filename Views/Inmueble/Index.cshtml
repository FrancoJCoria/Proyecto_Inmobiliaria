@model IEnumerable<Inmobiliaria.Models.Inmueble>

@{
	ViewData["Title"] = "Inmuebles";
	int cantidad = (int)(ViewData["Cantidad"] ?? 0);
	int paginaActual = ViewBag.PaginaActual ?? 1;
	var propietarios = ViewBag.Propietarios as IList<Inmobiliaria.Models.Propietario>;
	var tipos = ViewBag.Tipos as IList<Inmobiliaria.Models.TipoInmueble>;
}

<h1>Listado de Inmuebles (@cantidad)</h1>

<p>
	<a asp-action="Create" class="btn btn-primary">Crear nuevo inmueble</a>
	<a asp-action="BuscarDisponibles" class="btn btn-secondary">Buscar libres por fecha</a>
</p>

<table class="table table-striped align-middle">
	<thead>
		<tr>
			<th>Foto</th>
			<th>@Html.DisplayNameFor(model => model.Id_inmueble)</th>
			<th>@Html.DisplayNameFor(model => model.Direccion)</th>
			<th>Tipo</th>
			<th>@Html.DisplayNameFor(model => model.Cupo)</th>
			<th>Precio por dia</th>
			<th>Propietario</th>
			<th>Disponible</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			var duenio = propietarios?.FirstOrDefault(p => p.Id_propietario == item.Id_propietario);
			var tipo = tipos?.FirstOrDefault(t => t.Id_tipo == item.Id_tipo);
			<tr>
				<td>
					@if (!string.IsNullOrEmpty(item.Portada))
					{
						<img src="@item.Portada" alt="Foto" class="img-thumbnail" style="width: 70px; height: 50px; object-fit: cover;" />
					}
					else
					{
						<span class="text-muted" style="font-size: 0.8rem;">Sin foto</span>
					}
				</td>
				<td>@item.Id_inmueble</td>
				<td>@item.Direccion</td>
				<td>@(tipo != null ? tipo.Nombre : item.Id_tipo.ToString())</td>
				<td>@item.Cupo</td>
				<td>@item.Precio_dia.ToString("C")</td>
				<td>@(duenio != null ? duenio.Apellido + ", " + duenio.Nombre : item.Id_propietario.ToString())</td>
				<td>
					@if (item.Disponible)
					{
						<span class="badge bg-success">Si</span>
					}
					else
					{
						<span class="badge bg-secondary">No</span>
					}
				</td>
				<td>
					@* RESERVA *@
                    @if (item.Disponible)
                    {
                        <a asp-controller="Reserva" asp-action="Create" asp-route-idInmueble="@item.Id_inmueble" class="btn btn-sm btn-success">Reservar</a>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-secondary" disabled>Reservar</button>
                    }
					<a asp-action="Details" asp-route-id="@item.Id_inmueble" class="btn btn-sm btn-info">Detalles</a>
					<a asp-action="Edit" asp-route-id="@item.Id_inmueble" class="btn btn-sm btn-warning">Editar</a>
					<a asp-action="Imagenes" asp-route-id="@item.Id_inmueble" class="btn btn-sm btn-secondary">Fotos</a>
					<a asp-action="Delete" asp-route-id="@item.Id_inmueble" class="btn btn-sm btn-danger">Eliminar</a>
				</td>
			</tr>
		}
	</tbody>
</table>

@if (!Model.Any())
{
	<div class="alert alert-info">No hay inmuebles cargados todavía.</div>
}

<!------------------ Controles de paginación ------------------>
<div class="d-flex justify-content-center align-items-center gap-2 mt-4">
    @* Boton Anterior *@
    @if (paginaActual > 1)
    {
        <a asp-action="Index" asp-route-pagina="@(paginaActual - 1)" class="btn btn-outline-primary">&larr; Anterior</a>
    }
    else
    {
        <button class="btn btn-outline-secondary" disabled>&larr; Anterior</button>
    }

    @* Indicador de pagina *@
    <span class="badge bg-light text-dark border px-3 py-2 fs-6">Pagina @paginaActual</span>

    @* Botón Siguiente *@
    @if (cantidad == 5)
    {
        <a asp-action="Index" asp-route-pagina="@(paginaActual + 1)" class="btn btn-primary">Siguiente &rarr;</a>
    }
    else
    {
        <button class="btn btn-secondary" disabled>Siguiente &rarr;</button>
    }
</div>
