@model IEnumerable<Inmobiliaria.Models.Inmueble>

@{
	ViewData["Title"] = "Inmuebles";
	int cantidad = (int)(ViewData["Cantidad"] ?? 0);
	var propietarios = ViewBag.Propietarios as IList<Inmobiliaria.Models.Propietario>;
	int? filtroProp = ViewBag.FiltroPropietario as int?;
    bool? filtroDisp = ViewBag.FiltroDisponible as bool?;
    bool? filtroEst = ViewBag.FiltroEstado as bool?;
}

<h1>Listado de Inmuebles (@cantidad)</h1>

<p>
	<a asp-action="Create" class="btn btn-primary">Crear nuevo inmueble</a>
	<a asp-action="Informes" class="btn btn-outline-secondary">Informes</a>
</p>
<!-- Formulario de filtros -->
<form asp-action="Index" method="get" class="card card-body bg-light mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-bold">Propietario:</label>
            <input type="text" id="busquedaFiltroPropietario" class="form-control mb-2"
                placeholder="Escribí para filtrar por apellido, nombre o DNI..." autocomplete="off" />
            <select name="idPropietario" id="filtroPropietario" class="form-select" size="5">
                <option value="">-- Todos los propietarios --</option>
                @if (propietarios != null)
                {
                    foreach (var p in propietarios)
                    {
                        if (filtroProp == p.Id_propietario)
                        {
                            <option value="@p.Id_propietario" selected>@(p.Apellido + ", " + p.Nombre)</option>
                        }
                        else
                        {
                            <option value="@p.Id_propietario">@(p.Apellido + ", " + p.Nombre)</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold">Estado:</label>
            <select name="estado" class="form-select">
                <option value="">-- Todos --</option>
                @if (filtroEst.HasValue && filtroEst.Value == true)
                {
                    <option value="true" selected>Activo</option>
                    <option value="false">Inactivo</option>
                }
                else if (filtroEst.HasValue && filtroEst.Value == false)
                {
                    <option value="true">Activo</option>
                    <option value="false" selected>Inactivo</option>
                }
                else
                {
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-bold">Disponibilidad:</label>
            <select name="disponible" class="form-select">
                <option value="">-- Todos --</option>
                @if (filtroDisp.HasValue && filtroDisp.Value == true)
                {
                    <option value="true" selected>Solo Disponibles</option>
                    <option value="false">No Disponibles</option>
                }
                else if (filtroDisp.HasValue && filtroDisp.Value == false)
                {
                    <option value="true">Solo Disponibles</option>
                    <option value="false" selected>No Disponibles</option>
                }
                else
                {
                    <option value="true">Solo Disponibles</option>
                    <option value="false">No Disponibles</option>
                }
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpiar</a>
        </div>
    </div>
</form>
<partial name="_TablaInmuebles" model="Model" />

@if (!Model.Any())
{
	<div class="alert alert-info">No hay inmuebles cargados todavía.</div>
}

<!------------------ Controles de paginación ------------------>
@await Html.PartialAsync("_Paginador")

@section Scripts {
	<partial name="_ScriptDesplegable" />
	<script>
		// El valor vacío de la opción "Todos" se pasa explícitamente porque en este filtro
		// "sin selección" no es lo mismo que el id 0.
		activarBusquedaDesplegable('#busquedaFiltroPropietario', '#filtroPropietario',
			'@Url.Action("BuscarPropietarios", "Propietario")', '-- Todos los propietarios --', '');
	</script>
}
