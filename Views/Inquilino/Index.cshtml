@model IEnumerable<Inmobiliaria.Models.Inquilino>

@{
    ViewData["Title"] = "Inquilinos";
    int cantidad = (int)(ViewData["Cantidad"] ?? 0);
    int paginaActual = (int)(ViewBag.PaginaActual ?? 1);
    string saludo = (string)(ViewBag.Otro ?? "");}

<h1>Listado de Inquilinos (@cantidad)</h1>
<p>@saludo</p>
<p><a asp-action="Create" class="btn btn-primary">Crear nuevo inquilino</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id_inquilino)</th>
            <th>@Html.DisplayNameFor(model => model.Dni)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Apellido)</th>
            <th>@Html.DisplayNameFor(model => model.Telefono)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>@Html.DisplayNameFor(model => model.Estado)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id_inquilino</td>
                <td>@item.Dni</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.Telefono</td>
                <td>@item.Email</td>
                <td>
                    @if (item.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>}
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id_inquilino" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@item.Id_inquilino" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id_inquilino" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>}
    </tbody>
</table>

@if (!Model.Any())
{<div class="alert alert-info">No hay inquilinos cargados todavía.</div>}

<!--                                                                                                ------------      PAGINACIO   ---------------                           -->
<div class="d-flex justify-content-center align-items-center gap-2 mt-4">
    @* BOTON ANTERIOR *@
    @if (paginaActual > 1){ <a asp-action="Index" asp-route-pagina="@(paginaActual - 1)" class="btn btn-outline-primary">&larr; Anterior</a>}
    else
    {
        <button class="btn btn-outline-secondary" disabled>&larr; Anterior</button>}

    @* Indicador *@
    <span class="badge bg-light text-dark border px-3 py-2 fs-6">@paginaActual</span>

    @* Botón Siguiente *@
    @if (cantidad == 5)
    {
        <a asp-action="Index" asp-route-pagina="@(paginaActual + 1)" class="btn btn-primary">
            Siguiente &rarr;
        </a>
    }
    else
    {
        <button class="btn btn-secondary" disabled>Siguiente &rarr;</button>
    }
</div>