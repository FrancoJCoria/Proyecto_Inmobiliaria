@model Inmobiliaria.Models.Propietario

@{
	ViewData["Title"] = "Detalles del Propietario";
}

<h1>Detalles del Propietario</h1>

<dl class="row">
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Id_propietario)</dt>
	<dd class="col-sm-9">@Model.Id_propietario</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Dni)</dt>
	<dd class="col-sm-9">@Model.Dni</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
	<dd class="col-sm-9">@Model.Nombre</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Apellido)</dt>
	<dd class="col-sm-9">@Model.Apellido</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Telefono)</dt>
	<dd class="col-sm-9">@Model.Telefono</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
	<dd class="col-sm-9">@Model.Email</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Estado)</dt>
	<dd class="col-sm-9">
		@if (Model.Estado)
		{
			<span class="badge bg-success">Activo</span>
		}
		else
		{
			<span class="badge bg-secondary">Inactivo</span>
		}
	</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id_propietario" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
