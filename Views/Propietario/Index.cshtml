@model IEnumerable<Inmobiliaria.Models.Propietario>

@{
    ViewData["Title"] = "Propietarios";
    int cantidad = (int)(ViewData["Cantidad"] ?? 0);
    int paginaActual = (int)(ViewBag.PaginaActual ?? 1);
}

<h1>Listado de Propietarios (@cantidad)</h1>

<p><a asp-action="Create" class="btn btn-primary">Crear nuevo propietario</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id_propietario)</th>
            <th>@Html.DisplayNameFor(model => model.Dni)</th>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Apellido)</th>
            <th>@Html.DisplayNameFor(model => model.Telefono)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id_propietario</td>
                <td>@item.Dni</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.Telefono</td>
                <td>@item.Email</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id_propietario" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@item.Id_propietario" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Id_propietario" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay propietarios cargados todavía.</div>
}

<!--------------------------------------------------------------------------------------------- Controles de paginaciion-------------------------------------------------->
<div class="d-flex justify-content-center align-items-center gap-2 mt-4">
    @* Boton Anterior *@
    @if (paginaActual > 1)
    {
        <a asp-action="Index" asp-route-pagina="@(paginaActual - 1)" class="btn btn-outline-primary"> &larr; Anterior</a>
    }
    else
    {
        <button class="btn btn-outline-secondary" disabled>&larr; Anterior</button>
    }

    @* Indicador de pagina *@
    <span class="badge bg-light text-dark border px-3 py-2 fs-6">Pagina @paginaActual</span>

    @* Botón Siguiente *@
    @if (cantidad == 5)
    {
        <a asp-action="Index" asp-route-pagina="@(paginaActual + 1)" class="btn btn-primary">Siguiente &rarr;</a>
    }
    else
    {
        <button class="btn btn-secondary" disabled>Siguiente &rarr;</button>
    }
</div>