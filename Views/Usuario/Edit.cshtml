@model Inmobiliaria.Models.Usuario

@{
	ViewData["Title"] = "Editar Usuario";
}

<h1>Editar Usuario</h1>

<div class="row">
	<div class="col-md-5">
		<form asp-action="Edit" method="post" enctype="multipart/form-data">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" name="id" value="@Model.Id_usuario" />
			<input type="hidden" asp-for="Id_usuario" />
			<input type="hidden" asp-for="Estado" />
			<div class="mb-3">
				<label asp-for="Email" class="form-label"></label>
				<input asp-for="Email" class="form-control" />
				<span asp-validation-for="Email" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Clave" class="form-label"></label>
				<input asp-for="Clave" type="password" placeholder="Dejar en blanco para no cambiar" class="form-control" />
				<span asp-validation-for="Clave" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Nombre" class="form-label"></label>
				<input asp-for="Nombre" class="form-control" />
				<span asp-validation-for="Nombre" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label asp-for="Apellido" class="form-label"></label>
				<input asp-for="Apellido" class="form-control" />
				<span asp-validation-for="Apellido" class="text-danger"></span>
			</div>
			@if (User.IsInRole("Administrador"))
			{
				<div class="mb-3">
					<label asp-for="Rol" class="form-label"></label>
					<select asp-for="Rol" class="form-select">
						<option value="">-- Elegir rol --</option>
						<option value="Administrador">Administrador</option>
						<option value="Empleado">Empleado</option>
					</select>
					<span asp-validation-for="Rol" class="text-danger"></span>
				</div>
			}
			else
			{
				<input type="hidden" asp-for="Rol" />
			}
			<div class="mb-3">
				<label class="form-label d-block">Avatar</label>
				@if (!string.IsNullOrEmpty(Model.Avatar))
				{
					<img src="@Model.Avatar" width="80" class="img-thumbnail mb-2" />
				}
				else
				{
					<img src="https://ui-avatars.com/api/?rounded=true&name=@Model.Nombre+@Model.Apellido" width="80" class="img-thumbnail mb-2" />
				}
				<input asp-for="AvatarFile" type="file" accept="image/*" class="form-control" />
				<span asp-validation-for="AvatarFile" class="text-danger"></span>
			</div>
			<button type="submit" class="btn btn-primary">Guardar</button>
			@if (User.IsInRole("Administrador"))
			{
				<a asp-action="Index" class="btn btn-secondary">Volver</a>
			}
			else
			{
				<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
			}
		</form>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
