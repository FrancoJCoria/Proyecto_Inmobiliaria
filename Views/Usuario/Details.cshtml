@model Inmobiliaria.Models.Usuario

@{
	ViewData["Title"] = "Detalles del Usuario";
}

<h1>Detalles del Usuario</h1>

<dl class="row">
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Id_usuario)</dt>
	<dd class="col-sm-9">@Model.Id_usuario</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
	<dd class="col-sm-9">@Model.Email</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
	<dd class="col-sm-9">@Model.Nombre</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Apellido)</dt>
	<dd class="col-sm-9">@Model.Apellido</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Rol)</dt>
	<dd class="col-sm-9">@Model.Rol</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Avatar)</dt>
	<dd class="col-sm-9">@Model.Avatar</dd>
	<dt class="col-sm-3">@Html.DisplayNameFor(model => model.Estado)</dt>
	<dd class="col-sm-9">
		@if (Model.Estado)
		{
			<span class="badge bg-success">Activo</span>
		}
		else
		{
			<span class="badge bg-secondary">Inactivo</span>
		}
	</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id_usuario" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
