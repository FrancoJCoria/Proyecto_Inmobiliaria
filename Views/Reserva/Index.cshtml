@model IEnumerable<Inmobiliaria.Reserva>

@{
	ViewData["Title"] = "Reservas";
	int cantidad = (int)(ViewData["Cantidad"] ?? 0);
}

<h1>Listado de Reservas (@cantidad)</h1>

<p>
	<a asp-action="Create" class="btn btn-primary">Crear nueva reserva</a>
	<a asp-action="Informes" class="btn btn-outline-secondary">Informes</a>
</p>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Nro</th>
			<th>Desde</th>
			<th>Hasta</th>
			<th>Inmueble</th>
			<th>Inquilino</th>
			<th>Monto diario</th>
			<th>Estado</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.Id_reserva</td>
				<td>@item.Fecha_inicio.ToString("dd/MM/yyyy")</td>
				<td>@item.Fecha_fin.ToString("dd/MM/yyyy")</td>
				<td>@(string.IsNullOrEmpty(item.NombreInmueble) ? item.Id_inmueble.ToString() : item.NombreInmueble)</td>
				<td>@(string.IsNullOrEmpty(item.NombreInquilino) ? item.Id_inquilino.ToString() : item.NombreInquilino)</td>
				<td>@item.Monto_diario.ToString("C")</td>
				<td>
					@if (item.Fecha_fin_efectiva != DateTime.MinValue)
					{
						<span class="badge bg-info text-dark">Finalizada</span>
					}
					else if (item.Estado)
					{
						<span class="badge bg-success">Activa</span>
					}
					else
					{
						<span class="badge bg-secondary">Anulada</span>
					}
				</td>
				<td>
					<a asp-action="Details" asp-route-id="@item.Id_reserva" class="btn btn-sm btn-info">Detalles</a>
					<a asp-action="Edit" asp-route-id="@item.Id_reserva" class="btn btn-sm btn-warning">Editar</a>
					<a asp-controller="Pago" asp-action="Index" asp-route-idReserva="@item.Id_reserva" class="btn btn-sm btn-outline-primary">Pagos</a>
					@if (item.Id_usuario_finalizador == 0 && item.Fecha_fin_efectiva == DateTime.MinValue)
					{
						<a asp-action="Finalizar" asp-route-id="@item.Id_reserva" class="btn btn-sm btn-warning">Finalizar</a>
					}
					<a asp-action="Delete" asp-route-id="@item.Id_reserva" class="btn btn-sm btn-danger">Anular</a>
				</td>
			</tr>
		}
	</tbody>
</table>

@if (!Model.Any())
{
	<div class="alert alert-info">No hay reservas cargadas todavía.</div>
}

<!------------------ Controles de paginación ------------------>
@await Html.PartialAsync("_Paginador")
