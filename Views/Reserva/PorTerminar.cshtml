@model IEnumerable<Inmobiliaria.Reserva>

@{
	ViewData["Title"] = "Reservas por terminar";
	int cantidad = (int)(ViewData["Cantidad"] ?? 0);
	int plazo = (int)(ViewData["Dias"] ?? 30);
}

<h1>Reservas que terminan en los próximos @plazo días (@cantidad)</h1>

<form method="get" class="row g-2 mb-3">
	<div class="col-auto">
		<label class="form-label">Plazo (días)</label>
		<select name="dias" class="form-select">
			@foreach (var opcion in new[] { 7, 15, 30, 60, 90 })
			{
				if (opcion == plazo)
				{
					<option value="@opcion" selected>@opcion</option>
				}
				else
				{
					<option value="@opcion">@opcion</option>
				}
			}
		</select>
	</div>
	<div class="col-auto align-self-end">
		<button type="submit" class="btn btn-primary">Filtrar</button>
		<a asp-action="PorTerminar" class="btn btn-secondary">Limpiar</a>
	</div>
</form>

@if (Model.Any())
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Nro</th>
				<th>Desde</th>
				<th>Hasta</th>
				<th>Días restantes</th>
				<th>Inmueble</th>
				<th>Inquilino</th>
				<th>Monto diario</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				int diasRestantes = (item.Fecha_fin.Date - DateTime.Today).Days;
				<tr>
					<td>@item.Id_reserva</td>
					<td>@item.Fecha_inicio.ToString("dd/MM/yyyy")</td>
					<td>@item.Fecha_fin.ToString("dd/MM/yyyy")</td>
					<td>@diasRestantes</td>
					<td>@item.NombreInmueble</td>
					<td>@item.NombreInquilino</td>
					<td>@item.Monto_diario.ToString("C")</td>
					<td>
						<a asp-action="Details" asp-route-id="@item.Id_reserva" class="btn btn-sm btn-info">Detalles</a>
						<a asp-controller="Pago" asp-action="Index" asp-route-idReserva="@item.Id_reserva" class="btn btn-sm btn-outline-primary">Pagos</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">No hay reservas que terminen en los próximos @plazo días.</div>
}

<!------------------ Controles de paginación ------------------>
@await Html.PartialAsync("_Paginador")

<p>
	<a asp-action="Informes" class="btn btn-secondary">Volver a Informes</a>
</p>
