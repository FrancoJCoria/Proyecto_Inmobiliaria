@model IEnumerable<Inmobiliaria.Reserva>

@{
	ViewData["Title"] = "Reservas vigentes";
	int cantidad = (int)(ViewData["Cantidad"] ?? 0);
	DateTime desde = (DateTime)(ViewData["Desde"] ?? DateTime.Today);
	DateTime hasta = (DateTime)(ViewData["Hasta"] ?? DateTime.Today);
	var inmuebles = ViewBag.Inmuebles as IList<Inmobiliaria.Models.Inmueble>;
	var inquilinos = ViewBag.Inquilinos as IList<Inmobiliaria.Models.Inquilino>;
}

<h1>Reservas vigentes entre el @desde.ToString("dd/MM/yyyy") y el @hasta.ToString("dd/MM/yyyy") (@cantidad)</h1>

<form method="get" class="row g-2 mb-3">
	<div class="col-auto">
		<label class="form-label">Desde</label>
		<input type="date" name="desde" value="@desde.ToString("yyyy-MM-dd")" class="form-control" />
	</div>
	<div class="col-auto">
		<label class="form-label">Hasta</label>
		<input type="date" name="hasta" value="@hasta.ToString("yyyy-MM-dd")" class="form-control" />
	</div>
	<div class="col-auto align-self-end">
		<button type="submit" class="btn btn-primary">Filtrar</button>
		<a asp-action="Vigentes" class="btn btn-secondary">Limpiar</a>
	</div>
</form>

@if (Model.Any())
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Nro</th>
				<th>Desde</th>
				<th>Hasta</th>
				<th>Inmueble</th>
				<th>Inquilino</th>
				<th>Monto diario</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				var inm = inmuebles?.FirstOrDefault(m => m.Id_inmueble == item.Id_inmueble);
				var inq = inquilinos?.FirstOrDefault(q => q.Id_inquilino == item.Id_inquilino);
				<tr>
					<td>@item.Id_reserva</td>
					<td>@item.Fecha_inicio.ToString("dd/MM/yyyy")</td>
					<td>@item.Fecha_fin.ToString("dd/MM/yyyy")</td>
					<td>@(inm != null ? inm.Direccion : item.Id_inmueble.ToString())</td>
					<td>@(inq != null ? inq.Apellido + ", " + inq.Nombre : item.Id_inquilino.ToString())</td>
					<td>@item.Monto_diario.ToString("C")</td>
					<td>
						<a asp-action="Details" asp-route-id="@item.Id_reserva" class="btn btn-sm btn-info">Detalles</a>
						<a asp-controller="Pago" asp-action="Index" asp-route-idReserva="@item.Id_reserva" class="btn btn-sm btn-outline-primary">Pagos</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="alert alert-info">No hay reservas vigentes en el período indicado.</div>
}

<p>
	<a asp-action="Informes" class="btn btn-secondary">Volver a Informes</a>
</p>