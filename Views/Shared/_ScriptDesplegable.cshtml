@* Convierte un <select> de catálogo en un desplegable con búsqueda en servidor (Select2).
   Cada vista lo incluye y después lo activa con sus propios datos, por ejemplo:
     activarDesplegable('#Id_propietario', '/Propietario/BuscarPropietarios',
         '-- Elegir propietario --', 0);
     activarDesplegable('#filtroPropietario', '/Propietario/BuscarPropietarios',
         '-- Todos los propietarios --', '');

   El <select> llega a la vista con unicamente la opcion "-- Elegir --" y, si corresponde,
   la opcion que ya estaba elegida. Nunca se escribe ahi el catalogo completo: las opciones
   llegan por AJAX desde el servidor, que es quien filtra con el termino escrito.

   Se busca por AJAX y no con un formulario GET a proposito: al filtrar un desplegable
   no se pierden las fechas ni los montos que ya estan cargados en el formulario. *@
<script>
	// Un desplegable es un <select> real: Select2 escribe el id elegido en un input
	// oculto con el mismo name, asi que el formulario sigue enviando el valor normal.
	//   url           action que devuelve [{ id, etiqueta }] filtrado por ?termino=
	//   textoVacio    etiqueta de la opcion "-- Elegir --"
	//   valorVacio    value de esa opcion: '0' en formularios, '' en filtros de listado
	function activarDesplegable(select, url, textoVacio, valorVacio) {
		$(select).select2({
			language: 'es',
			placeholder: textoVacio,
			// Caracteres minimos antes de consultar. Tiene que coincidir con
			// BusquedaDesplegable.LongitudMinima: con menos caracteres el servidor
			// responde una lista vacia, porque un prefijo tan corto ("a") coincide con
			// casi todo y no acotaria nada.
			minimumInputLength: 3,
			maximumInputLength: 60,
			width: '100%',
			ajax: {
				url: url,
				type: 'GET',
				dataType: 'json',
				// Espera a que el usuario se detenga antes de consultar.
				delay: 300,
				cache: true,
				data: function (params) {
					return { termino: params.term || '' };
				},
				processResults: function (respuesta) {
					return {
						results: respuesta.map(function (item) {
							return { id: item.id, text: item.etiqueta };
						})
					};
				}
			}
		});
	}
</script>
